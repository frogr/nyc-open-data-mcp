# All optional. Copy to .env or set in your host's dashboard.

# Free Socrata app token, raises the upstream rate limit a lot.
# https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=

# Per-request timeout for Socrata calls, ms (stdio default 20000, HTTP default 15000).
SOCRATA_TIMEOUT_MS=

# ---- HTTP server only (npm start / dist/http.js) ----
PORT=3000
HOST=0.0.0.0
# Requests per minute per IP on POST /mcp.
RATE_LIMIT_PER_MINUTE=30
# Requests per UTC day on POST /mcp across all callers (protects the shared Socrata quota).
DAILY_REQUEST_LIMIT=5000
# Largest accepted POST body in bytes.
MAX_BODY_BYTES=65536
# Wall-clock limit for one /mcp request, ms.
REQUEST_TIMEOUT_MS=30000
# "*" or a comma-separated list of allowed browser origins.
CORS_ORIGINS=*
# Number of reverse proxies in front of the app (Render: 1). 0 = use the socket address.
TRUST_PROXY=0
